NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://phiguess:CHANGE_ME@127.0.0.1:5432/phiguess
POSTGRES_PASSWORD=CHANGE_ME
ASSET_DIR=./storage/assets
AVATAR_DIR=./storage/avatars
# Exact browser origin, including external NAT port when applicable.
PUBLIC_ORIGIN=http://localhost:3000
# Set to 1 only when running behind the provided Caddy reverse proxy.
TRUST_PROXY=0
# Linux host port mapped by the cloud NAT service.
HTTP_PORT=8080
